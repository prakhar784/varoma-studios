{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "varoma-studios-site",
  "main": "./worker.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "VAROMA_DB",
      "database_name": "varoma-leads",
      "database_id": "1b916287-b03e-4c69-a6c2-6cc088a36631"
    }
  ]
}
